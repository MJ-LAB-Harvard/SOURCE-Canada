Rx vs heroin availability index=
	IF THEN ELSE(switch for heroin index=1, XIDZ ( Rx availability for UD endogenous , 
	             Heroin availability index , 
	             1), 1)
	~	dmnl
	~	The relative availability of Rx opioids compared to heroin, each compared \
		to their availability at model start (INITIAL TIME).
	|

switch for heroin index=
	0
	~	dmnl [0,1,1]
	~		|

Tx capacity effective[Bup]=
	Bup capacity estimated ~~|
Tx capacity effective[MMT]=
	MMT capacity estimated
	~	people
	~	The effective capacity for each treatment type.
	|

Total PWURx NP Rx OUD NDHU and HUD DATA=
	Total PWURx NP or OUD no PY heroin DATA+Total NDHU Rx OUD with PY heroin and HUD DATA
	~	person
	~		|

Total PWURx NP Rx OUD NDHU and HUD=
	Total NDHU Rx OUD with PY heroin and HUD+Total Rx use excl heroin
	~	person
	~		|

Tx seeking fraction Bup Rx OUD=
	0.266354
	~	dmnl [0.25,1,0.025]
	~	[EXP] The proportion of all Rx OUDs seeking MOUD treatment who are seeking \
		buprenorphine specifically. [Source: Dr. Alex Walley, personal \
		communication 7/1/20] Calibrated value from Canada_main_MC.out.
	|

Tx seeking fraction Bup HUD=
	0.815991
	~	dmnl [0.25,1,0.025]
	~	[EXP] This represents the proportion of all HUDs seeking treatment \
		who are specifically seeking and/or receive buprenorphine. [Source: Dr. \
		Alex Walley, personal communication, 7/1/20, Dr. Ben Bearnot, personal \
		communication 7/1/20] Calibrated value from Canada_main_MC.out.
	|

Tx seeking fraction MMT Rx OUD= INITIAL(
	 ( 1 - Tx seeking fraction Bup Rx OUD ))
	~	dmnl
	~	The proportion of all Rx OUDs seeking MOUD treatment who are seeking \
		methadone: 1 - Tx seeking fraction Bup Rx OUD (Vivitrol is not modelled \
		in Canada).
	|

Tx seeking fraction MMT HUD= INITIAL(
	 ( 1
	                  - Tx seeking fraction Bup HUD ) 
	                )
	~	dmnl
	~	The proportion of all HUDs seeking MOUD treatment who are seeking \
		methadone: 1 - Tx seeking fraction Bup HUD (Vivitrol is not modelled in \
		Canada).
	|

OUD redefinition fixed effect=
	1
	~	dmnl [0.1,0.5]
	~	Size of a potential survey redefinition effect on reported OUD.
		Potential mechanism for a change in survey definitions of OUD. Not active \
		in the Canadian version (time = 2100, fixed effect = 1, so the effect \
		stays 1); left in the model in case needed.
	|

HUD DATA no redefinition:INTERPOLATE::=
	IMP DATA HUD
	~	people
	~	IF THEN ELSE(Switch for alternative HUD data=0, IMP DATA HUD ,  HUD DATA alternative \
		)
		
		(1 - Switch for alternative HUD data) * IMP DATA HUD + Switch for alternative HUD \
		data * HUD DATA alternative
		
		Individuals with HUD, calculated from data. [Source: NSDUH adjusted with \
		RAND ratio]
	|

OUD redefinition effect=
	1
	             - RAMP ( OUD redefinition fixed effect 
	                       / ( 1
	                            + OUD redefinition fixed effect ) 
	                       / OneYear  , 
	                  OUD redefinition time , 
	                  ( OUD redefinition time 
	                       + OneYear  ) )
	~	dmnl
	~	The magnitude (based on redefinition fixed effect) and timing (redefinition time) of \
		a potential survey redefinition effect on reported OUD.
		Potential mechanism for a change in survey definitions of OUD. Not active \
		in the Canadian version (time = 2100, fixed effect = 1, so the effect \
		stays 1); left in the model in case needed.
	|

Rx OUD with PY heroin DATA no redefinition:INTERPOLATE::=
	IMP DATA Rx OUD with PY heroin
	~	people
	~	IMP DATA Rx OUD with PY heroin
	|

OUD redefinition time=
	2100
	~	year
	~	Year of a potential survey redefinition.
		Potential mechanism for a change in survey definitions of OUD. Not active \
		in the Canadian version (time = 2100, fixed effect = 1, so the effect \
		stays 1); left in the model in case needed.
	|

Nondisordered heroin use DATA no redefinition:INTERPOLATE::=
	IMP DATA NDHU
	~	people
	~	IMP DATA NDHU
	|

initial MMT=
	INITIAL(IMP DATA Tx point patients OAT MMT)
	~	person
	~		|

initial bup seeking fraction=
	initial Bup/(initial Bup+initial MMT)
	~	dmnl
	~		|

initial Bup=
	INITIAL(IMP DATA Tx point patients OAT Bup)
	~	person
	~		|

Initial bup fraction with Rx OUD with H=
	0.0048
	~	dmnl [0,0.5]
	~	[DATA] TEDS analysis of 1999 data (Fraction of all planned MAT episodes \
		for a primary substance of heroin, rx opioids or non Rx methadone where Rx \
		opioids were the primary drug named as "substance of abuse" and heroin was \
		the secondary - assumed MMT was only MAT being planned [Source: TEDSA 1999]
	|

Initial bup fraction with HUD=
	0.115
	~	dmnl [0,1]
	~	[DATA] Canada: 0.115 = past-month heroin use (self-report) among 492 \
		methadone patients in 13 Ontario clinics [Source: Bawor et al. 2015, \
		Biology of Sex Differences]. No direct Canadian split by use disorder was \
		found. Before 2014 most Canadian MOUD patients were treated for \
		prescription-opioid dependence, so the US value does not apply. The same \
		value is used for methadone and buprenorphine. The rest of the initial \
		MOUD patients are Rx OUD (with PY heroin: 0.0048, US value; without: the \
		remainder). [US SOURCE: TEDSA 1999, value 0.96: fraction of all planned \
		MAT episodes for a primary substance of heroin, Rx opioids or non-Rx \
		methadone where heroin was the primary or only substance named; assumed \
		MMT was the only MOUD being planned]
	|

Tx effective capacity fraction[Bup]=
	Bup OAT capacity utilization ~~|
Tx effective capacity fraction[MMT]=
	MMT OAT capacity utilization
	~	dmnl
	~	The fraction of theoretical treatment capacity that is actually \
		utilizable, due to a combination of provider/facility choices, turnover \
		loss, spatiotemporal mismatch, and other such factors. Not used in any \
		equation in the Canadian version: the 80% effective capacity fraction is \
		applied in Data imported into Vensim.xlsx when Bup and MMT capacity are \
		estimated from treatment receipt data (capacity = start-of-year receipt / \
		0.8).
	|

Fentanyl effect on OD rate H max net=
	((1-Switch for fentanyl effect on OD rate H max test) * Fentanyl effect on OD rate H max\
		 + Switch for fentanyl effect on OD rate H max test * Fentanyl effect on OD rate H max test\
		)
	             * ( 1
	                  + RAMP ( Policy change fentanyl effect on OD rate
	                            / Policy rampup duration , 
	                       Policy activation time , 
	                       Policy activation time 
	                            + Policy rampup duration ) )
	~	dmnl
	~	Maximum multiplier of OD rate due to fentanyl, after accounting for policy \
		changes. Conceptually, how much more likely fentanyl is to cause an OD \
		than heroin for any given incident of use
	|

Average days per prescription relative=
	zidz(Average days per prescription, Average days per prescription reference)
	~	dmnl
	~	The current average length of opioid prescriptions relative to model \
		initiation.
	|

Average duration of medical opioid use=
	Average days per prescription * Prescriptions per person * OneDay
	~	Years
	~	Average person-years of use or exposure per year, equivalent to the \
		average duration of use (in years), after accounting for policy changes.
	|

Patients with current month opioid Rx=
	Patients receiving opioid prescription annual 
	             * Average duration of medical opioid use
	~	people
	~	Estimated total number of patients with current-month opioid analgesic \
		prescriptions.
	|

Total Rx MME prescribed=
	Patients receiving opioid prescription annual * Prescriptions per person * Average days per prescription\
		 * Average MME per day
	~	MME/year
	~	Total opioid MMEs dispensed in any given year
	~	:SUPPLEMENTARY 
	|

Total overdose deaths heroin and excess estimated=
	IF THEN ELSE ( Time 
	                                 > Total overdose data last time , 
	                            :NA:, 
	IMP DATA OD deaths heroin no synth 
	                                 + OD deaths synth excess estimated)
	~	person/Years
	~		|

Rx supply relative=
	Average MME per day relative 
	             ^ (4 * Sensitivity of Rx supply to MME per day / (Sensitivity of Rx supply to MME per day\
		 + Sensitivity of Rx supply to patients receiving prescription
	 + Sensitivity of Rx supply to Rx per person + Sensitivity of Rx supply to days per prescription\
		))
	             * Patients receiving opioid prescription annual relative 
	                  ^ (4 * Sensitivity of Rx supply to patients receiving prescription\
		/ (Sensitivity of Rx supply to MME per day
	 + Sensitivity of Rx supply to patients receiving prescription + Sensitivity of Rx supply to Rx per person\
		 + Sensitivity of Rx supply to MME per day)) * Prescriptions per person relative
	 ^ (4 * Sensitivity of Rx supply to Rx per person / (Sensitivity of Rx supply to MME per day\
		 + Sensitivity of Rx supply to patients receiving prescription
	 + Sensitivity of Rx supply to Rx per person + Sensitivity of Rx supply to days per prescription\
		)) 
	* Average days per prescription relative
	             ^ (4 * Sensitivity of Rx supply to MME per day / (Sensitivity of Rx supply to MME per day\
		 + Sensitivity of Rx supply to patients receiving prescription
	 + Sensitivity of Rx supply to Rx per person + Sensitivity of Rx supply to days per prescription\
		))
	~	dmnl
	~	Supply of prescription opioids available for potential NP use, indexed to \
		model start. Can be thought of as 'excess' pills not used as prescribed \
		within the time period of the prescription, which therefore present \
		potential opportunities for NP use.
	|

Average days per prescription reference= INITIAL(
	Average days per prescription)
	~	person*days/Rx
	~	The average length in days of opioid prescriptions at model initiation. \
		[Source: IQVIA]
	|

Sensitivity of Rx supply to days per prescription=
	1
	~	dmnl
	~	[ASM] Weight parameter determining the relative importance of prescription \
		durations (days/Rx) vs. number of people with opioid prescriptions, \
		prescription strengths, etc. in affecting the supply of 'excess' Rx \
		available for NP use. A value of 1 is neutral, giving equal importance to \
		size & number. A values less than 1 indicates that diversion is driven \
		more by the number of people with a prescription, while a value greater \
		than 1 indicates diversion is driven more by the strength of presriptions.
	|

Heroin availability index=
	1/Heroin price index
	~	dmnl
	~	Availability of heroin relative to start of model run, represented as \
		inverse of price.
	|

Rx OUD in stable remission total=
	Rx OUD no heroin in stable remission + Rx OUD with heroin in stable remission
	~	people
	~	Total people with Rx OUD in stable remission
	|

Developing HUD rate with Rx OUD net=
	Developing HUD rate with Rx OUD
	             * ( 1
	                  + RAMP ( Policy change HUD with Rx OUD development rate
	                            / Policy rampup duration , 
	                       Policy activation time , 
	                       Policy activation time 
	                            + Policy rampup duration ) )
	~	1/year
	~	The rate of developing heroin use disorder among people who have \
		nondisordered heroin use as well as an existing Rx OUD, after accounting \
		for policy changes.
	|

Developing Rx OUD rate effective=
	Developing Rx OUD rate net
	             * Rx availability coeff developing Rx OUD 
	             * Social influence coeff developing Rx OUD
	~	1/year
	~	Net per-person-year hazard rate of developing Rx OUD incorporating effects \
		of feedbacks and other drivers
	|

Developing Rx OUD rate net=
	Developing Rx OUD rate
	             * ( 1
	                  + RAMP ( Policy change Rx OUD development rate
	                            / Policy rampup duration , 
	                       Policy activation time , 
	                       Policy activation time 
	                            + Policy rampup duration ) )
	~	1/year
	~	The rate of developing Rx OUD among PWURx-NP, after accounting for policy \
		changes.
	|

Developing HUD rate with Rx OUD effective=
	Developing HUD rate with Rx OUD net
	             * Social influence coeff developing HUD 
	             * Rx vs H availability coeff developing HUD with Rx OUD
	~	1/year
	~	Net per-person-year hazard rate of developing HUD with Rx OUD \
		incorporating effects of feedbacks and other drivers
	|

Developing HUD rate no Rx OUD net=
	Developing HUD rate no Rx OUD
	             * ( 1
	                  + RAMP ( Policy change HUD no Rx OUD development rate
	                            / Policy rampup duration , 
	                       Policy activation time , 
	                       Policy activation time 
	                            + Policy rampup duration ) )
	~	1/year
	~	The rate of developing heroin use disorder among people who have \
		nondisordered heroin use but without Rx OUD, after accounting for policy \
		changes.
	|

Developing HUD rate no Rx OUD effective=
	Developing HUD rate no Rx OUD net
	             * Heroin availability coeff developing HUD 
	             * Social influence coeff developing HUD
	~	1/year
	~	Net per-person-year hazard rate of developing HUD without Rx OUD \
		incorporating effects of feedbacks and other drivers
	|

Fraction of NDHU with Rx avg=
	Fraction of NDHU who use Rx
	~	dmnl [0.3,0.85]
	~	Fraction of people with NDHU that also use Rx opioids. [Source: NSDUH] \
		Canada: set equal to Fraction of NDHU who use Rx (a constant, the average \
		of the Canadian survey values). GET DATA MEAN is not used here because it \
		returns :NA: when its argument is a constant rather than a data series.
	|

Fraction of HUD with Rx OUD or Rx NP avg=
	Fraction of HUD who use Rx
	~	dmnl [0,1,0.125]
	~	Fraction of individuals with HUD that also use Rx opioids, whether NP use \
		or UD. [Source: NSDUH] Canada: set equal to Fraction of HUD who use Rx (a \
		constant, the average of the Canadian survey values). GET DATA MEAN is not \
		used here because it returns :NA: when its argument is a constant rather \
		than a data series.
	|

Rx OUD with heroin in stable remission= INTEG (
	Stabilizing remission Rx OUD with H-NonOD death Rx OUD with H in stable remission,
		Initial Rx OUD with H in stable remission)
	~	people
	~	Individuals with OUD and NDHU use who are in stable remission, ie, have \
		been in remission for greater than 5 years
	|

Social influence strength relapse=
	0
	~	dmnl
	~	The multiplier effect of social influence on relapse rates. Used only for \
		policy testing - KEEP THIS AT ZERO by default
	|

Relapsing to HUD=
	HUD in remission 
	             * Relapse rate HUD net * Social influence coefficient relapse
	~	person/Years
	~		|

Relapsing to Rx OUD with H=
	Rx OUD with heroin in remission 
	             * Relapse rate HUD net * Relapse rate Rx OUD relative to HUD * Social influence coefficient relapse
	~	person/Years
	~		|

Relapsing to Rx OUD no H=
	Rx OUD no heroin in remission 
	             * Relapse rate HUD net * Relapse rate Rx OUD relative to HUD * Social influence coefficient relapse
	~	people/year
	~		|

Social influence strength relapse net=
	Social influence strength relapse
	
	                  + RAMP ( Policy change social influence strength relapse
	                            / Policy rampup duration , 
	                       Policy activation time , 
	                       Policy activation time 
	                            + Policy rampup duration )
	~	dmnl
	~	The multiplier effect of social influence on relapse rates, after \
		accounting for any policy changes. Used only for policy testing - KEEP \
		THIS AT ZERO by default
	|

Heroin availability coeff initiating NDHU no Rx=
	Heroin availability index
	             ^ Heroin availability strength initiating NDHU no Rx
	~	dmnl
	~	The sensitivity of the rate of heroin initiation in individuals with no \
		prior Rx use to the price of heroin.Sign is negative because lower heroin \
		price index results in higher initiation, but for consistency, heroin \
		price strength is expressed as positive
	|

Heroin availability coeff developing HUD=
	Heroin availability index 
	             ^  Heroin availability strength developing HUD
	~	dmnl
	~	The sensitivity of the rate of HUD development to the price of heroin.Sign \
		is negative because lower heroin price index results in higher initiation, \
		but for consistency, heroin price strength is expressed as positive
	|

Heroin availability coeff net quit NDHU=
	Heroin availability index
	             ^ - Heroin availability strength net quit NDHU
	~	dmnl
	~	The sensitivity of the rate of quitting heroin to the price of heroin.Sign \
		is negative because lower heroin price index results in higher initiation, \
		but for consistency, heroin price strength is expressed as positive.
	|

SI on remission relative=
	SI on remission current/SI on remission reference
	~	dmnl
	~		|

SI on remission reference= INITIAL(
	SI on remission current)
	~	dmnl
	~		|

Social influence coefficient remission=
	SI on remission relative^Social influence strength remission
	~	dmnl
	~		~	:SUPPLEMENTARY 
	|

Social influence coefficient relapse=
	SI on remission relative^ -Social influence strength relapse net
	~	dmnl
	~		|

Social influence strength remission=
	0
	~	dmnl
	~	The multiplier effect of social influence on remission rates. Used only for policy \
		testing - KEEP THIS AT ZERO by default
		KEEP THIS AT ZERO by default
	|

SI on remission current=
	Total in Remission/Population
	~	dmnl
	~		|

Rx vs H availability coeff initiating NDHU with Rx=
	Rx vs heroin availability index
	             ^ (- Rx vs H availability strength initiating NDHU with Rx)
	~	dmnl
	~	The multiplier effect of the relative price of Rx opioids compared to \
		heroin (relative to their respective prices at model initiation) on \
		initiating nondisordered heroin use among PWURx-NP.
	|

Rx availability for UD relative=
	Rx availability for Rx NP relative * Max ( ( 1
	                       - Rx street supply disruption ) , 
	                  0.01)
	~	dmnl
	~	The availability of prescription opioids for people with Rx OUD, relative \
		to model start (INITIAL TIME), reflecting the balance of supply and \
		demand, not accounting for potential desirability differences of ADFs. \
		(Supply may include counterfeit supply, when data become available.)
	|

Rx availability for UD endogenous=
	Rx availability for UD relative * ((1 - ADF fraction of Rx street supply net
	) + ADF fraction of Rx street supply net * ADF relative desirability
	)
	~	dmnl
	~	The availability of prescription opioids for people with Rx OUD, relative \
		to model start (INITIAL TIME), reflecting the balance of supply and \
		demand, theoretically accounting for potential desirability differences of \
		ADFs (though presently inactive). Supply may include counterfeit supply, \
		when data become available.
	|

Overdose death rate base HUD no synth counterfactual=
	Overdose rate base HUD 
	
	             * ( 1
	                  - Base survival probability H OD ) 
	             * Probability OD death not averted NDHU Rx OUD with PY heroin and HUD
	~	1/year
	~	Expected overdose death rate for individuals with HUD in counterfactual \
		scenario with no illegal synthetics
	~	:SUPPLEMENTARY 
	|

Cumulative UD person years= INTEG (
	Total with UD,
		0)
	~	person * Years
	~	Cumulative person-years of use disorder from start of model run.
	~	:SUPPLEMENTARY 
	|

Probability Nx bystander heroin prior=
	IF THEN ELSE(Time = 2019, 0.2, :NA:)
	~	dmnl
	~	[DATA] Probability of naloxone distribution by a bystander [Source: Irvine \
		et al 2020]
	|

Projected cumulative overdose deaths= INTEG (
	Projected total overdose deaths,
		0)
	~	people
	~	Cumulative overdose deaths from start of model projections.
	~	:SUPPLEMENTARY 
	|

Projected cumulative UD person years= INTEG (
	Projected total with UD,
		0)
	~	person * Years
	~	Cumulative person-years of use disorder from start of model projections.
	~	:SUPPLEMENTARY 
	|

Projected total with UD=
	IF THEN ELSE (Time < MaxDataTime, 0, Total with UD)
	~	people
	~		|

Projected total overdose deaths=
	IF THEN ELSE (Time < MaxDataTime, 0, Total overdose deaths)
	~	people/year
	~		|

Total in Remission=
	Total HUD in remission + Total in Rx OUD Remission
	~	person
	~	The number of people in remission, totaled across those in treatment and \
		out of treatment.
	|

Total HUD in remission not in Tx=
	HUD in remission + HUD in stable remission
	~	person
	~		|

Total HUD in remission=
	Total HUD in remission not in Tx + SUM(HUD in remission in MOUD Tx[TxT!])
	~	person
	~		|

Total in Rx OUD Remission=
	SUM(Rx OUD no PY heroin in remission in MOUD Tx[TxT!]) + SUM(Rx OUD with PY heroin in remission in MOUD Tx\
		[TxT!]) + Total Rx OUD in Remission not in Tx
	~	person
	~		|

Total Rx OUD in Remission not in Tx=
	Rx OUD no heroin in remission 
	             + Rx OUD with heroin in remission
	                         + Rx OUD no heroin in stable remission 
	                                          + Rx OUD with heroin in stable remission
	~	people
	~		|

Initial Rx OUD no H in stable remission= INITIAL(
	Initial stock base values[OUS] 
	                  * Initial stock correction[OUS])
	~	people
	~		|

Initial Rx OUD with H in stable remission= INITIAL(
	Initial stock base values[OHS] 
	                  * Initial stock correction[OHS])
	~	people
	~		|

Initial HUD in stable remission= INITIAL(
	Initial stock base values[HUS] * Initial stock correction[HUS])
	~	people
	~		|

HUD in stable remission= INTEG (
	Stabilizing remission HUD-NonOD death HUD in stable remission,
		Initial HUD in stable remission)
	~	people
	~		|

NonOD death Rx OUD with H in stable remission=
	Rx OUD with heroin in stable remission*NonOD death rate no opioid use
	~	person/Years
	~		|

NonOD death HUD in stable remission=
	HUD in stable remission 
	             * NonOD death rate no opioid use
	~	person/Years
	~		|

Time to stabilize remission = 9.74248
	~	Years
	~	[ACAL, LIT] The point at which the risk of relapse/return to use disorder \
		becomes similar to the risk of use disorder development among the general \
		population. Literature estimates are that it takes about 5 years of \
		remission from disorder before it stabilizes.This is equal to four years \
		because individuals already have one year of remission when they get to \
		the remission stock. [Source:Y.-I. Hser et al. 2015; DuPont, Compton, and \
		McLellan 2015]
	|

Stabilizing remission Rx OUD no H=
	Rx OUD no heroin in remission/Time to stabilize remission
	~	people/year
	~		|

Rx OUD no heroin in stable remission= INTEG (
	Stabilizing remission Rx OUD no H-NonOD death Rx OUD no H in stable remission,
		Initial Rx OUD no H in stable remission)
	~	people
	~	Individuals with OUD and no heroin use who are in stable remission, ie, \
		have been in remission for greater than 5 years
	|

NonOD death Rx OUD no H in stable remission=
	Rx OUD no heroin in stable remission 
	             * NonOD death rate no opioid use
	~	person/Years
	~		|

Stabilizing remission HUD=
	HUD in remission/Time to stabilize remission
	~	person/Years
	~		|

HUD in remission= INTEG (
	 SUM ( Tx exit in remission HUD[TxT!] ) 
	                  - NonOD death HUD in remission 
	                  - Relapsing to HUD 
	                  + Remitting HUD no MOUD Tx
	                  - Stabilizing remission HUD,
		 
		             Initial HUD in remission)
	~	people
	~	Individuals with HUD in remission.
	|

Rx OUD with heroin in remission= INTEG (
	 SUM ( Tx exit in remission Rx OUD with H[TxT!] ) 
	                  - NonOD death Rx OUD with H in remission 
	                  - Relapsing to Rx OUD with H 
	                  + Remitting Rx OUD with H no MOUD Tx
	                   - Stabilizing remission Rx OUD with H,
		 
		             Initial Rx OUD with H in remission)
	~	people
	~		|

Stabilizing remission Rx OUD with H=
	Rx OUD with heroin in remission/Time to stabilize remission
	~	person/Years
	~		|

Rx OUD no heroin in remission= INTEG (
	 SUM ( Tx exit in remission Rx OUD no H[TxT!] ) 
	                  - NonOD death Rx OUD no H in remission 
	                  - Relapsing to Rx OUD no H 
	                  + Remitting Rx OUD no H no MOUD Tx
	 -Stabilizing remission Rx OUD no H,
		 
		             Initial Rx OUD no H in remission)
	~	people
	~		|

ADF relative desirability=
	1
	~	dmnl
	~	[ASM] % price average ADFs vs. non-ADFs. This is a placeholder value that \
		should be kept at 1 to deactivate until ADF impacts on availability are \
		fully formulated.
	|

Cumulative Nx utilization deaths averted= INTEG (
	Nx utilization deaths averted NDHU Rx OUD with PY heroin and HUD + Nx utilization deaths averted PWURx NP or OUD\
		,
		0)
	~	people
	~	Cumulative deaths averted through naloxone use from start of model run.
	~	:SUPPLEMENTARY 
	|

Total overdoses synth baseline=
	Overdose rate synth baseline * Rx OUD no PY heroin no MOUD
	~	people/year
	~	Total overdoses from presumptive prescription synthetics.
	|

Cumulative overdose deaths synth excess= INTEG (
	Total overdose deaths synth excess,
		0)
	~	people
	~	Cumulative overdose deaths from illegal synthetics, from start of model \
		run.
	~	:SUPPLEMENTARY 
	|

Overdose death rate HUD no Nx counterfactual=
	Overdose rate net HUD * (1 - Base survival probability net H OD) * ( 1
	                  - Probability OD witnessed net 
	                       * Probability of calling emergency services net )
	~	1/year
	~	Expected overdose death rate for individuals with HUD in counterfactual \
		scenario with no naloxone
	~	:SUPPLEMENTARY 
	|

Nx utilization deaths averted NDHU Rx OUD with PY heroin and HUD=
	Nx utilization events NDHU Rx OUD with PY heroin and HUD * (1 - Base survival probability net H OD\
		) * (1 - Probability of calling emergency services net)
	~	people/year
	~	Deaths averted by use of naloxone in overdoses experienced by NDHU Rx OUD \
		with PY heroin and HUD
	|

Nx utilization deaths averted PWURx NP or OUD=
	Nx utilization events PWURx NP or OUD * (Total overdoses Rx synth baseline fraction \
		* (1 - Base survival probability fentanyl OD) + (1 - Total overdoses Rx synth baseline fraction\
		) * (1 - Base survival probability Rx OD)) * (1 -  Probability of calling emergency services net\
		)
	~	people/year
	~	Deaths averted by use of naloxone in overdoses experienced by PWURx NP or \
		OUD
	|

Total overdoses Rx synth baseline fraction=
	Total overdoses synth baseline / Total overdoses Rx
	~	dmnl
	~	Fraction of overdoses among PWURx NP or OUD involving presumptive \
		prescription synthetics.
	|

Nx kits distributed PWURx NP or OUD=
	Nx kits distributed net
	             * ( 1
	                  - Fraction Nx kits to NDHU Rx OUD with PY heroin and HUD )
	~	kits
	~	The estimated number of naloxone kits distributed by harm reduction \
		programs and through mail and retail channels (IQVIA) to PWURx NP or OUD.
	|

Nx kits distributed NDHU Rx OUD with PY heroin and HUD=
	Nx kits distributed net * Fraction Nx kits to NDHU Rx OUD with PY heroin and HUD
	~	kits
	~	The estimated number of naloxone kits distributed by harm reduction \
		programs and through mail and retail channels (IQVIA) to NDHU Rx OUD with \
		PY heroin and HUD. [Source: IQVIA, Wheeler 2015]
	|

NormErr[TSElm]=
	IF THEN ELSE(DataVar[TSElm]=:NA:, :NA:, zidz((DataVar[TSElm]-SimVar[TSElm]),SimVar[TSElm\
		])) ~~|
NormErr[PrElm]=
	:NA:
	~	1
	~	Residuals for time series data (data - simulated values) normalised to \
		simulated values.
	|

TSElm:
	FlElm, StElm
	~	
	~		|

Rx street supply shocks=
	OxyContin withdrawal supply impact 
	             + Rx street supply impact policy
	~	1/year
	~		|

NonOD death HUD  = 
        HUD no MOUD 
             * NonOD death rate HUD or OUD
	~	people/year
	~		|

NonOD death rate NDHU  = 
        ( NonOD death rate HUD or OUD 
             + NonOD death rate Rx NP ) 
             / 2
	~	1/year
	~	[LIT, ASM] [Source: Eklund 2014, CDC WONDER, Degenhardt 2011 and Larney \
		2019]
	|

NonOD death Rx OUD no H  = 
        Rx OUD no PY heroin no MOUD 
             * NonOD death rate HUD or OUD
	~	people/year
	~		|

NonOD death Rx OUD with H  = 
        Rx OUD with PY heroin no MOUD 
             * NonOD death rate HUD or OUD
	~	people/year
	~		|

NonOD death rate HUD or OUD in Tx[TxT]=
	(1-Remission fraction in Tx[TxT]) * NonOD death rate HUD or OUD 
		                  * Effect of MOUD Tx on NonOD death rate[TxT] + Remission fraction in Tx\
		[TxT] * NonOD death rate no opioid use
	~	1/year
	~		|

Initiation rate heroin with Rx OUD effective=
	Initiation rate heroin with Rx OUD 
	             * Rx vs H availability coeff initiating heroin with Rx OUD 
	             * Perceived risk coeff initiating heroin with Rx OUD 
	             * Social influence coeff initiating heroin with Rx OUD 
	             * ADF effect coeff initiating heroin with Rx OUD
	~	1/year
	~	Net per-person-year hazard rate of initiating heroin use with Rx OUD \
		incorporating effects of feedbacks and other drivers
	|

Initiating heroin with Rx NP=
	PWURx NP no PY heroin * MIN( Max per capita flow rate, Initiation rate heroin with Rx NP effective\
		 )
	~	person/Years
	~	Per-capita rate capped at Max per capita flow rate (numerical safeguard; \
		see that variable).
	|

Initiation rate Rx NP own Rx effective=
	Initiation rate Rx NP own Rx net 
	             * Perceived risk coeff initiating Rx NP own Rx
	~	1/year
	~	Net per-person-year hazard rate of initiating Rx NP use with own Rx \
		incorporating effects of feedbacks and other drivers
	|

Developing HUD with Rx OUD=
	Rx OUD with PY heroin no MOUD * MIN( Max per capita flow rate, Developing HUD rate with Rx OUD effective\
		 )
	~	people/year
	~	Per-capita rate capped at Max per capita flow rate (numerical safeguard; \
		see that variable).
	|

Initiating Rx NP own Rx=
	Patients with current month opioid Rx 
	             * Initiation rate Rx NP own Rx effective
	~	people/year
	~		|

Developing HUD no Rx OUD=
	Nondisordered heroin use * MIN( Max per capita flow rate, Developing HUD rate no Rx OUD effective\
		 )
	~	people/year
	~	Individuals developing HUD without first developing Rx OUD. Per-capita \
		rate capped at Max per capita flow rate (numerical safeguard; see that \
		variable).
	|

Initiating heroin with Rx OUD=
	Rx OUD no PY heroin no MOUD * MIN( Max per capita flow rate, Initiation rate heroin with Rx OUD effective\
		 )
	~	people/year
	~	Per-capita rate capped at Max per capita flow rate (numerical safeguard; \
		see that variable).
	|

Developing Rx OUD=
	PWURx NP no PY heroin * MIN( Max per capita flow rate, Developing Rx OUD rate effective\
		 )
	~	people/year
	~	Per-capita rate capped at Max per capita flow rate (numerical safeguard; \
		see that variable).
	|

Initiation rate heroin with Rx NP effective=
	Initiation rate heroin with Rx NP net 
	             * Rx vs H availability coeff initiating NDHU with Rx 
	             * Perceived risk coeff initiating NDHU with Rx 
	             * Social influence coeff initiating NDHU with Rx
	~	1/year
	~	Net per-person-year hazard rate of initiating heroin use with Rx NP use \
		incorporating effects of feedbacks and other drivers
	|

Nx utilization events total=
	Nx utilization events NDHU Rx OUD with PY heroin and HUD + Nx utilization events PWURx NP or OUD
	~	person/Years
	~		|

Rx OUD in early or Tx remission=
	Rx OUD no heroin in remission + Rx OUD with heroin in remission + SUM(Rx OUD no PY heroin in remission in MOUD Tx\
		[TxT!] + Rx OUD with PY heroin in remission in MOUD Tx[TxT!])
	~	people
	~		|

HUD in early or Tx remission=
	HUD in remission + SUM(HUD in remission in MOUD Tx[TxT!])
	~	people
	~		|

Nx utilization events NDHU Rx OUD with PY heroin and HUD fraction=
	zidz(Nx utilization events NDHU Rx OUD with PY heroin and HUD, Nx utilization events total\
		)
	~	dmnl
	~	Fraction of total overdose events where naloxone is utilized that are in \
		NDHU Rx OUD with PY heroin and HUD (and not PWURx NP or OUD)
	|

Patients receiving opioid prescription annual relative=
	Patients receiving opioid prescription annual
	             / Patients receiving opioid prescription annual reference
	~	dmnl
	~	The current number of patients with active opioid prescriptions relative \
		to model initiation.
	|

Relapse rate Rx OUD relative to HUD = 0.253647
	~	dmnl
	~	[ACAL]Rate at which individuals with Rx OUD relapse relative to that rate \
		in individuals with HUD
	|

Prescriptions per person relative=
	Prescriptions per person / Prescriptions per person reference
	~	dmnl
	~		|

Sensitivity of Rx supply to Rx per person=
	1
	~	dmnl
	~	[MCAL] Sensitivity of Rx opioid street supply to number of Rxs to patients \
		receiving prescription opioids.
	|

Patients receiving opioid prescription annual reference= INITIAL(
	Patients receiving opioid prescription annual)
	~	people/year
	~	The number of patients with an active opioid prescription at model \
		initiation. [Source: IQVIA]
	|

Sensitivity of Rx supply to patients receiving prescription=
	1
	~	dmnl
	~	[MCAL] Sensitivity of Rx opioid street supply to patients receiving \
		prescription opioids.
	|

Prescriptions per person reference= INITIAL(
	Prescriptions per person)
	~	Rx/person
	~		|

Nx utilization events NDHU Rx OUD with PY heroin and HUD fraction prior=
	IF THEN ELSE(Time = 2013, 0.86, :NA:)
	~	dmnl
	~	[LIT] The fraction of all overdose reversals reported to harm reduction \
		programs that were reported to be used for non-prescription opioid opioid \
		(i.e., heroin) overdoses. Used as a prior to calibrate the estimated \
		fraction of all kits distributed to NDHU Rx OUD with PY heroin and HUD. \
		[Source: Wheeler 2015]
	|

Total prescription opioid Rx=
	Patients receiving opioid prescription annual * Prescriptions per person
	~	Rx/year
	~	Total opioid analgesic prescriptions dispensed each year
	~	:SUPPLEMENTARY 
	|

Overdose rate net NDHU=
	Overdose rate base NDHU 
	
	             * ( 1
	                  + Fentanyl penetration curve 
	                       * ( Fentanyl effect on OD rate H max net
	                            - 1) )
	~	1/year
	~	The overdose rate for people with NDHU, after accounting for effects of \
		fentanyl.
	|

Overdose rate net HUD=
	Overdose rate base HUD 
	
	             * ( 1
	                  + Fentanyl penetration curve 
	                       * ( Fentanyl effect on OD rate H max net
	                            - 1) )
	~	1/year
	~	The overdose rate for people with HUD, accounting for effects of fentanyl.
	|

Rx street supply impact policy=
	PULSE(Policy activation time, Policy rampup duration) * Policy change Rx street supply shocks
	~	1/year
	~		|

Tx success fraction[TxT]=
	IF THEN ELSE ( Tx average duration net[TxT] 
	                  <= Tx success fraction inflection , 
	             zidz ( Tx success fraction kappa 
	                       ^ 2, 
	                  1
	                       + Tx success fraction kappa
	                            ^ 2) 
	                  * EXP ( ( Tx success fraction lambda 
	                            / Tx success fraction kappa ) 
	                            * ( Tx average duration net[TxT] 
	                                 - Tx success fraction inflection ) ) , 
	             1
	                  - zidz ( 1, 
	                       1
	                            + Tx success fraction kappa 
	                                 ^ 2) 
	                       * EXP ( - Tx success fraction lambda 
	                                 * Tx success fraction kappa
	                                 * ( Tx average duration net[TxT] 
	                                      - Tx success fraction inflection ) ) ) 
	             * Tx success fraction max
	~	dmnl
	~	Fraction of people leaving Tx who leave 'successfully', i.e. in remission \
		rather than returning to UD, based on the average duration of treatment \
		for each MOUD.
	|

Tx seeking fraction by med HUD[Bup]=
	Tx seeking fraction Bup HUD ~~|
Tx seeking fraction by med HUD[MMT]  = 
        INITIAL( Tx seeking fraction MMT HUD  )
	~	dmnl
	~	Share of treatment seekers with HUD seeking each medication: Bup share \
		calibrated, MMT share = 1 - Bup share.
	|

Tx seeking fraction by med Rx OUD[Bup]=
	Tx seeking fraction Bup Rx OUD ~~|
Tx seeking fraction by med Rx OUD[MMT]  = 
        INITIAL( Tx seeking fraction MMT Rx OUD  )
	~	dmnl
	~	Share of treatment seekers with Rx OUD seeking each medication: Bup \
		share calibrated, MMT share = 1 - Bup share.
	|

Nx kit distribution efficiency = 0.0001
	~	person/kit [0.0005,0.005]
	~	[ACAL] The efficiency with which naloxone is distributed to the right \
		people and places. The larger this value, the faster saturation is reached \
		(i.e. probability of bystander naloxone availability --> 100%). An \
		increase in this value means fewer kits are needed to reach a given \
		probability of naloxone use per witnessed OD.
	|

Nx kit distribution efficiency net=
	Nx kit distribution efficiency
	             * ( 1
	                  + RAMP ( Policy change Nx kit distribution efficiency
	                            / Policy rampup duration , 
	                       Policy activation time , 
	                       Policy activation time 
	                            + Policy rampup duration ) )
	~	person/kit [0.0005,0.005]
	~	The efficiency with which naloxone is distributed to the right people and \
		places, after accounting for any policy changes.
	|

Nx utilization events NDHU Rx OUD with PY heroin and HUD=
	Total overdoses heroin * Probability OD witnessed net * Probability Nx bystander heroin
	~	people/year
	~	The annual number of times naloxone is used to reverse a heroin overdose.
	|

Nx utilization events PWURx NP or OUD=
	Total overdoses Rx * Probability OD witnessed net * Probability Nx bystander Rx
	~	people/year
	~	The annual number of times naloxone is used to reverse a prescription \
		opioid overdose.
	|

Nx kit utilization fraction NDHU Rx OUD with PY heroin and HUD=
	zidz(Nx utilization events NDHU Rx OUD with PY heroin and HUD * Nx kits per utilization event
	             , Nx kits distributed NDHU Rx OUD with PY heroin and HUD)
	~	dmnl
	~	The value of this should match estimates from literature for fraction of \
		kits utilized, which ranges from 5.7% (Wheeler 2015) to a weighted average \
		of 12.9%. Note this is 6% when Wheeler 2015 is also used to calculate the \
		weighted average. [Source: Galea 2006, Katzman 2020, Doe-Simkins 2009, \
		Enteen 2010, Tobin 2009, Leece 2013, Tzemis 2014, Strang 2008, Yokell \
		2011, Lopez-Gaston 2009, Wheeler 2015]
	~	:SUPPLEMENTARY 
	|

Nx kit utilization fraction PWURx NP or OUD=
	zidz(Nx utilization events PWURx NP or OUD * Nx kits per utilization event
	             , Nx kits distributed PWURx NP or OUD)
	~	dmnl
	~	The value of this should match estimates from literature for fraction of \
		kits utilized, which ranges from 5.7% (Wheeler 2015) to a weighted average \
		of 12.9%. Note this is 6% when Wheeler 2015 is also used to calculate the \
		weighted average. [Source: Galea 2006, Katzman 2020, Doe-Simkins 2009, \
		Enteen 2010, Tobin 2009, Leece 2013, Tzemis 2014, Strang 2008, Yokell \
		2011, Lopez-Gaston 2009, Wheeler 2015]
	~	:SUPPLEMENTARY 
	|

Nx kits per utilization event=
	1
	~	kits/(person/year)
	~	NOTE: PLACEHOLDER VALUE - we do not have the data to disambiguate this \
		from distribution efficiency effects. Naloxone kits used in the event of \
		an overdose reversed through bystander naloxone administration.
	|

Nx kits per 100k population NDHU Rx OUD with PY heroin and HUD=
	Nx kits distributed NDHU Rx OUD with PY heroin and HUD / Population * 100000
	~	kits/person
	~	The number of naloxone kits (measured either in kits or in Rx, from IQVIA) \
		per 100k population to people who are likely to reverse overdoses among \
		NDHU Rx OUD with PY heroin and HUD (e.g. NDHU Rx OUD with PY heroin and \
		HUD themselves, family and community members thereof, etc.).
	|

Probability Nx bystander Rx=
	1 - EXP(-Nx kit distribution efficiency net * Nx kits per 100k population PWURx NP or OUD\
		)
	~	dmnl
	~	The likelihood that a bystander will administer naloxone in the event of a \
		witnessed prescription opioid overdose, after accounting for any policy \
		changes.
	|

Nx kits per 100k population PWURx NP or OUD=
	Nx kits distributed PWURx NP or OUD / Population * 100000
	~	kits/person
	~	The number of naloxone kits (measured either in kits or in Rx, from IQVIA) \
		per 100k population to people who are likely to reverse overdoses among \
		PWURx NP or OUD (e.g. PWURx NP or OUD themselves, family and community \
		members thereof, etc.).
	|

Probability Nx bystander heroin=
	1 - EXP(-Nx kit distribution efficiency net * Nx kits per 100k population NDHU Rx OUD with PY heroin and HUD\
		)
	~	dmnl
	~	The likelihood that a bystander will administer naloxone in the event of a \
		witnessed heroin overdose, after accounting for any policy changes. \
		Estimated weighted average of 34% in 2017 (assumed for heroin overdoses). \
		See 'Estimated Nx distribution efficiency based on Irvine...Green 2020'
	|

Tx seeking rate Rx OUD with H[TxT]=
	Tx seeking rate Rx OUD no H[TxT]
	~	1/year
	~	The rate at which individuals with Rx opioid use disorder and heroin use \
		seek MOUD treatment.
	|

Tx demand Rx OUD with H[TxT]=
	Rx OUD with PY heroin no MOUD 
	             * Tx seeking rate Rx OUD with H[TxT] 
	             * ( 1
	                  - Tx seeking barrier loss fraction)
	~	people/year
	~		|

Tx demand Rx OUD no H[TxT]=
	Rx OUD no PY heroin no MOUD 
	             * Tx seeking rate Rx OUD no H[TxT]
	             * ( 1
	                  - Tx seeking barrier loss fraction)
	~	person/Years
	~		|

Tx demand HUD[TxT]=
	HUD no MOUD 
	             * Tx seeking rate HUD[TxT] 
	             * ( 1
	                  - Tx seeking barrier loss fraction)
	~	people/year
	~		|

Bup demand fulfilment ratio prior=
	IF THEN ELSE(Time =2018, 0.587, :NA:)
	~	dmnl
	~	[LIT] The fraction of demand (after accounting for non-access barriers) \
		that is met, thereby reflecting access barriers. This value is used as a \
		prior for 2018 to calibrate the model. [Source: Beetham 2019].
	|

Fraction Rx OUD by MOUD[TxT]=
	zidz((Rx OUD by MOUD[TxT] + Rx OUD no PY heroin in remission in MOUD Tx[TxT] + Rx OUD with PY heroin in remission in MOUD Tx
	[TxT]),Total by MOUD[TxT])
	~	dmnl
	~		~	:SUPPLEMENTARY 
	|

Total by MOUD[TxT]=
	HUD by MOUD[TxT] 
	             + Rx OUD no heroin by MOUD[TxT] 
	             + Rx OUD with heroin by MOUD[TxT]
	             + HUD in remission in MOUD Tx[TxT]
	             + Rx OUD no PY heroin in remission in MOUD Tx[TxT]
	             + Rx OUD with PY heroin in remission in MOUD Tx[TxT]
	~	person
	~	Number of people in each type of MOUD treatment, totaled across use \
		disorders.
	|

Fraction HUD by MOUD[TxT]=
	zidz((HUD by MOUD[TxT] + HUD in remission in MOUD Tx[TxT]),Total by MOUD[TxT])
	~	dmnl
	~	The proportion of all people in each MOUD treatment who have or are in \
		remission from HUD.
	~	:SUPPLEMENTARY 
	|

Total in Remission by MOUD[TxT]=
	HUD in remission in MOUD Tx[TxT]+Rx OUD no PY heroin in remission in MOUD Tx[TxT]+Rx OUD with PY heroin in remission in MOUD Tx\
		[TxT]
	~	people
	~	The number of people in remission in each MOUD treatment, totaled across \
		use disorders.
