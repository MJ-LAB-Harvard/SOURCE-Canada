DataPriorBase[ReSO]=
	Rx OUD in stable remission total prior/unit people ~~|
DataPriorBase[ReSH]=
	HUD in stable remission total prior/unit people
	~	dmnl
	~		|

SimPrior[StElm]=
	:NA: ~~|
SimPrior[FlElm]=
	:NA: ~~|
SimPrior[NFRR]=
	Nonfatal OD ratio Rx ~~|
SimPrior[NFRH]=
	Nonfatal OD ratio heroin ~~|
SimPrior[DFRB]=
	Tx demand fulfilment ratio[Bup] ~~|
SimPrior[NxHF]=
	Nx utilization events NDHU Rx OUD with PY heroin and HUD fraction ~~|
SimPrior[RemO]=
	Rx OUD in early or Tx remission/unit people ~~|
SimPrior[RemH]=
	HUD in early or Tx remission/unit people ~~|
SimPrior[PNxH]=
	Probability Nx bystander heroin ~~|
SimPrior[ReSO]=
	Rx OUD in stable remission total/unit people ~~|
SimPrior[ReSH]=
	HUD in stable remission/unit people
	~	dmnl
	~		|

DataVarBase[RMis]=
	PWURx NP no PY heroin DATA redef corrected/unit people ~~|
DataVarBase[ROUD]=
	IMP DATA Rx OUD no PY heroin/unit people ~~|
DataVarBase[ROUH]=
	Rx OUD with PY heroin DATA/unit people ~~|
DataVarBase[NDHU]=
	Nondisordered heroin use DATA/unit people ~~|
DataVarBase[HUD]=
	HUD DATA/unit people ~~|
DataVarBase[TxBp]:INTERPOLATE::=
	Tx point patients Bup DATA/unit people ~~|
DataVarBase[TxMt]:INTERPOLATE::=
	IMP DATA MMT receipt/unit people ~~|
DataVarBase[ODRB]:INTERPOLATE::=
	IMP DATA OD deaths Rx no heroin no synth/unit people per year ~~|
DataVarBase[ODHC]=
	Total overdose deaths heroin and excess estimated/unit people per year ~~|
DataVarBase[ODSB]=
	OD deaths synth baseline estimated/unit people per year ~~|
DataVarBase[InRM]=
	Initiating Rx NP own Rx HOLD DATA redef correction/unit people per year ~~|
DataVarBase[InRD]:INTERPOLATE::=
	Initiating Rx NP diverted HOLD DATA/unit people per year ~~|
DataVarBase[InHT]:INTERPOLATE::=
	Total heroin initiation DATA/unit people per year ~~|
DataVarBase[InHD]:INTERPOLATE::=
	Initiating heroin no Rx DATA/unit people per year ~~|
DataVarBase[InHR]:INTERPOLATE::=
	Initiating heroin with Rx NP DATA/unit people per year ~~|
DataVarBase[InHO]:INTERPOLATE::=
	Initiating heroin with Rx OUD DATA/unit people per year ~~|
DataVarBase[PrElm]=
	:NA: ~~|
DataVarBase[ODTo]:INTERPOLATE::=
	IMP DATA OD deaths total/unit people per year
	~	dmnl
	~		|

RepErrRaw[TSElm, Year]=
	RANDOM PINK NOISE( 0, Noise SD[TSElm], Pink noise correlation time, Seed noise) ~~|
RepErrRaw[PrElm, Year]=
	:NA:
	~	dmnl
	~	RANDOM PINK NOISE( {mean}, {std deviation}, {correlation time}, {seed} )
	|

Initial stock base values[RXM]= INITIAL(
	 PWURx NP no PY heroin DATA redef corrected) ~~|
Initial stock base values[NDH]= INITIAL(
	 Nondisordered heroin use DATA) ~~|
Initial stock base values[OUB]=
	IMP DATA Tx point patients OAT Bup 
	                  * ( 1
	                       - Initial bup fraction with HUD
	                       - Initial bup fraction with Rx OUD with H ) ~~|
Initial stock base values[OUM]= INITIAL(
	 IMP DATA Tx point patients OAT MMT 
	                  * ( 1
	                       - Initial MMT fraction with HUD 
	                       - Initial MMT fraction with Rx OUD with H )) ~~|
Initial stock base values[OUT]= INITIAL(
	 IMP DATA Rx OUD no PY heroin) ~~|
Initial stock base values[OUR]= INITIAL(
	 Initial Rx OUD in remission LIT 
	                  * ( 1
	                       - Initial fraction lifetime Rx use with lifetime H use LIT ) 
	                  * ( 1
	                       - Remission fraction in Tx MMT )) ~~|
Initial stock base values[OHB]=
	IMP DATA Tx point patients OAT Bup
	                  * Initial bup fraction with Rx OUD with H ~~|
Initial stock base values[OHM]= INITIAL(
	 IMP DATA Tx point patients OAT MMT 
	                  * Initial MMT fraction with Rx OUD with H) ~~|
Initial stock base values[OHT]= INITIAL(
	 Rx OUD with PY heroin DATA) ~~|
Initial stock base values[OHR]= INITIAL(
	 Initial Rx OUD in remission LIT 
	                  * Initial fraction lifetime Rx use with lifetime H use LIT 
	                  * ( 1
	                       - Remission fraction in Tx MMT )) ~~|
Initial stock base values[HUB]=
	IMP DATA Tx point patients OAT Bup 
	                  * Initial bup fraction with HUD ~~|
Initial stock base values[HUM]= INITIAL(
	 IMP DATA Tx point patients OAT MMT 
	                  * Initial MMT fraction with HUD) ~~|
Initial stock base values[HUT]= INITIAL(
	 HUD DATA) ~~|
Initial stock base values[HUR]= INITIAL(
	 Initial HUD in remission LIT 
	                  * ( 1
	                       - Remission fraction in Tx MMT )) ~~|
Initial stock base values[OUS]= INITIAL(
	Initial Rx OUD in stable remission LIT * (1 - Initial fraction lifetime Rx use with lifetime H use LIT\
		)) ~~|
Initial stock base values[OHS]= INITIAL(
	Initial Rx OUD in stable remission LIT * Initial fraction lifetime Rx use with lifetime H use LIT\
		) ~~|
Initial stock base values[HUS]= INITIAL(
	Initial HUD in stable remission LIT)
	~	people
	~	Stock value at model initiation
	|

Elm:
	RMis,ROUD,ROUH,NDHU,HUD,TxBp,TxMt,InRM,InRD,InHT,InHD,InHR,InHO,ODRB,ODHC,ODSB,ODTo,\
		NFRR,NFRH,DFRB,PNxH,NxHF,RemO,RemH,ReSO,ReSH
	~	
	~		|

PET : Normal,MAPE,Gaussian,NegBin,LogGauss
	~	
	~		|

Year:
	Y09,(Y10-Y35)
	~	
	~		|

PriorErr[Elm]=
	IF THEN ELSE ( DataPrior[Elm] 
	                  = :NA:
	                  :OR: SimPrior[Elm] 
	                       = :NA:, 
	             0, 
	             - ( ( SimPrior[Elm] 
	                  - DataPrior[Elm] ) 
	                  * Weights[Normal,Elm] ) 
	                  ^ 2
	                  / 2 / TIME STEP)
	~	1/Years
	~	Note: If priors are point / annual values, need to divide by TIME STEP to \
		give comparable weight in payoff (due to time series data contributing to \
		payoff every TIME STEP); otherwise priors will be under-weighted \
		proportional to TIME STEP.
	~	:SUPPLEMENTARY 
	|

MAX THREADS=
	46
	~	dmnl
	~	Maximum number of parallel process threads to run. For use when running \
		with Vengine on multi-core server. Set to (number of cores - 2)
	~	:SUPPLEMENTARY 
	|

IsYear[Year]:INTERPOLATE:
	~	dmnl
	~		|

DataVar[Elm]=
	IF THEN ELSE(Time <= Data end time[Elm] :AND: Time >= Data start time[Elm], DataVarBase\
		[Elm], :NA:)
	~	dmnl
	~	Data used in the calibration only between Data start time and Data end \
		time. Vensim holds a data series at its first value before its first data \
		point, so a later start has to be set here.
	|

Data end time[Elm]:EXCEPT:[ODTo]=
	MaxDataTime ~~|
Data end time[ODTo]=
	2025
	~	year
	~	Last year each calibration target is used. MaxDataTime (2024) for all \
		targets except total overdose deaths, which use the 2025 national total \
		(5,704 apparent opioid toxicity deaths) [Source: PHAC Health Infobase, \
		September 2026 release]. The calibration runs to FINAL TIME \
		2025 (Data2024.cin); after MaxDataTime the exogenous inputs follow the \
		projection curves (ProjEndValsCA_base.cin), as in the projection runs.
	|

Data start time[Elm]:EXCEPT:[TxMt]=
	2009 ~~|
Data start time[TxMt]=
	2015.5
	~	year
	~	First year each calibration target is used.
	|

SynVar[Elm]=
	IF THEN ELSE(DataVar[Elm] = :NA:, :NA: , RepVar[Elm] )
	~	dmnl
	~		|

RepVar[TSElm]=
	SimVar[TSElm] * (1 +  RAMP(1, NoiseStartTime , NoiseStartTime + 1) * RepErr[TSElm]) ~~|
RepVar[PrElm]=
	:NA:
	~	1
	~	SimVar[TSElm] * (1 +  RAMP(1, NoiseStartTime , NoiseStartTime + 1) * \
		RepErr[TSElm])
	|

NoiseStartTime=
	2036
	~	year
	~	Time from which measurement noise is added to the reported series \
		(RepVar). 2036 by default, so the calibration has no noise. Noise2024.cin \
		sets 2024 for the projection runs with prediction intervals \
		(Canada_projection_sensitivity.cmd); the intervention runs set 2037.
	|

Switch for historical noise=
	1
	~	dmnl
	~	If set to 0, recovers DataVar as RepVar; if set to 1, generates RepVar \
		with new (simulated) noise stream
	|

RepErr[TSElm]=
	Max(-0.999, IF THEN ELSE(Switch for historical noise = 1, SUM(RepErrRaw[TSElm,Year!]\
		 * IsYear calc[Year!]), IF THEN ELSE(NormErr[TSElm] = :NA:, SUM(RepErrRaw[TSElm,Year\
		!] * IsYear calc[Year!]), NormErr[TSElm]))) ~~|
RepErr[PrElm]=
	:NA:
	~	dmnl
	~		|

MaxDataTime=
	2024
	~	year
	~	Last year of data used for calibration (Canadian data through 2024).
	|

BaseErr[Normal,Elm]=
	PEType[Normal] 
	             * IF THEN ELSE ( DataVar[Elm] 
	                       = :NA:, 
	                  0, 
	                  - ( ( SimVar[Elm] 
	                       - DataVar[Elm] ) 
	                       * Weights[Normal,Elm] ) 
	                       ^ 2) ~~|
BaseErr[MAPE,Elm]=
	PEType[MAPE] 
	             * IF THEN ELSE ( DataVar[Elm] 
	                       = :NA:, 
	                  0, 
	                  - ABS ( zidz ( ( SimVar[Elm] 
	                                 - DataVar[Elm] ) , 
	                            DataVar[Elm] ) ) 
	                       * 100) ~~|
BaseErr[Gaussian,Elm]=
	PEType[Gaussian] 
	             * IF THEN ELSE ( DataVar[Elm]= :NA: 
	                     :OR: Weights[Gaussian,Elm]=0 , 
	                  0, 
	                  - zidz(( SimVar[Elm] 
	                       - DataVar[Elm] ) 
	                       ^ 2
	                       , Weights[Gaussian,Elm] 
	                            ^ 2)
	                       / 2
	                       - ln ( Weights[Gaussian,Elm] ) ) ~~|
BaseErr[NegBin,Elm]=
	PEType[NegBin] 
	             * IF THEN ELSE ( DataVar[Elm]= :NA: 
	                     :OR: Weights[NegBin,Elm]=0 , 
	                  0,  
	                  IF THEN ELSE ( DataVar[Elm] 
	                            = 0, 
	                       - ln ( 1
	                                 + Weights[NegBin,Elm] 
	                                      * Max ( eps , 
	                                           SimVar[Elm] ) ) 
	                            / Weights[NegBin,Elm] , 
	                       GAMMA LN ( DataVar[Elm] 
	                                 + 1
	                                      / Weights[NegBin,Elm] ) 
	                            - GAMMA LN ( 1
	                                      / Weights[NegBin,Elm] ) 
	                            - GAMMA LN ( DataVar[Elm] 
	                                      + 1) 
	                            - ( DataVar[Elm] 
	                                 + 1
	                                      / Weights[NegBin,Elm] ) 
	                                 * ln ( 1
	                                           + Weights[NegBin,Elm] 
	                                                * Max ( eps , 
	                                                     SimVar[Elm] ) ) 
	                            + DataVar[Elm] 
	                                 * ( ln ( Weights[NegBin,Elm] ) 
	                                      + ln ( Max ( eps , 
	                                                SimVar[Elm] ) ) ) ) ) ~~|
BaseErr[LogGauss,Elm]=
	PEType[LogGauss] 
	             * IF THEN ELSE ( DataVar[Elm]= :NA: 
	                     :OR: Weights[Gaussian,Elm]=0 , 
	                  0, 
	                  0 )
	~	dmnl
	~	PEType[Gaussian] 
		             * IF THEN ELSE ( DataVar[Elm] 
		                       = :NA:, 
		                  0, 
		                  - ( SimVar[Elm] 
		                       - DataVar[Elm] ) 
		                       ^ 2
		                       / Weights[Gaussian,Elm] 
		                            ^ 2
		                       / 2
		                       - ln ( Weights[Gaussian,Elm] ) )
		
		PEType[LogGauss] 
		             * IF THEN ELSE ( DataVar[Elm]= :NA: 
		                     :OR: Weights[Gaussian,Elm]=0 , 
		                  0, 
		                  - zidz(( ln ( SimVar[Elm] 
		                            + eps ) 
		                       - ln ( DataVar[Elm] 
		                                 + eps ) ) 
		                       ^ 2
		                       , Weights[Gaussian,Elm] 
		                            ^ 2)
		                       / 2
		                       - ln ( Weights[Gaussian,Elm] + eps) )
	~	:SUPPLEMENTARY 
	|

eps  = 0.0001
	~	dmnl
	~		|

Initial stock correction[Initials]=
	0.986809, 0.608815, 0.6, 1, 0.888301, 1.4, 1.12949, 0.668281, 1, 1.30108, 1.39743, 1.0394\
		, 0.6, 1, 0.601148, 0.639364, 0.953213
	~	dmnl
	~	[ACAL] Multiplier for initial values of stocks to account for noise/error \
		in initial data point. Calibrated values from Canada_main_MC.out. \
		Methadone treatment stocks (OUM, OHM, HUM) are fixed at 1 and not \
		calibrated: there are no methadone data before mid-2015 to check the 2009 \
		value, so the start comes directly from the backcast (IMP DATA Tx point \
		patients OAT MMT, 34,173 in 2009).
	|

PEType[PET]=
	0, 0, 1, 0, 0
	~	dmnl
	~		|

StDev[Elm]=
	1
	~	dmnl
	~		|

WeightMod[Elm]  = 1
	~	dmnl
	~		|

WeightModManual[Elm]  = 1
	~	dmnl
	~		|

Weights[Normal,Elm]  = 
        INITIAL( 1
                  / StDev[Elm] 
                  * WeightModManual[Elm]  ) ~~|
Weights[Gaussian,Elm]= INITIAL(
	
	zidz(  StDev[Elm] 
	                  * WeightMod[Elm] , WeightModManual[Elm])) ~~|
Weights[MAPE,Elm]  = 
        INITIAL( 1
                  * WeightModManual[Elm]  ) ~~|
Weights[NegBin,Elm]  = 
        INITIAL( WeightModManual[Elm] 
                  * WeightMod[Elm]  ) ~~|
Weights[LogGauss,Elm]= INITIAL(
	zidz(  StDev[Elm] 
	                  * WeightMod[Elm]  , WeightModManual[Elm] )
	
	                 )
	~	dmnl
	~		|

********************************************************
	.Control
********************************************************~
		Simulation Control Parameters
	|

OneDay=
	0.00273973
	~	Years / day
	~		|

OneYear=
	1
	~	year
	~	Time constant reflecting one year.
	|

FINAL TIME  = 2036
	~	year
	~	The final time for the simulation.
	|

INITIAL TIME  = 2009
	~	year
	~	The initial time for the simulation.
	|

SAVEPER  = 1
	~	year [0,?]
	~	The frequency with which output is stored.
	|

TIME STEP  = 0.0625
	~	year [0,?]
	~	The time step for the simulation.
	|

********************************************************
	.input
********************************************************~
	|

ADF fraction of prescribed Rx opioids=
	Projection output data[ADF] 
	             + RAMP ( IF THEN ELSE ( Policy change ADF fraction of prescribed Rx opioids\
		 
	                            >= 0, 
	                       Policy change ADF fraction of prescribed Rx opioids 
	                            * ( 1
	                                 - Projection output data[ADF] ) , 
	                       Policy change ADF fraction of prescribed Rx opioids 
	                            * Projection output data[ADF] ) 
	                       / (Policy rampup duration ), 
	                  Policy activation time , 
	                  Policy activation time 
	                       + (Policy rampup duration) )
	~	dmnl
	~	The fraction of prescribed opioids that are FDA-approved abuse-deterrent \
		formulations (ADF), after accounting for policy changes.
	|

Nx kits distributed net=
	unit Nx kits distributed net*Projection output data[NxKD] 
	             * ( 1
	                  + RAMP ( Policy change Nx kits distributed
	                            / Policy rampup duration , 
	                       Policy activation time , 
	                       Policy activation time 
	                            + Policy rampup duration ) )
	~	kits
	~		|

Average days per prescription=
	unit Average days per prescription*Projection output data[RxDur]
	             * ( 1
	                  + RAMP ( Policy change days per prescription
	                            / Policy rampup duration , 
	                       Policy activation time , 
	                       Policy activation time 
	                            + Policy rampup duration ) )
	~	person*days/Rx
	~	The average length (in days) of opioid prescriptions, after accounting for \
		policy changes.
	|

Bup capacity estimated=
	unit Bup capacity estimated*Projection output data[BupCap] 
	             * ( 1
	                  + RAMP ( Policy change Bup capacity 
	                            / Policy rampup duration , 
	                       Policy activation time , 
	                       Policy activation time 
	                            + Policy rampup duration ) )
	~	person
	~	Estimated capacity in Bup treatment, ie, max number of people that could \
		theoretically be in Bup treatment at a given time.
	|

Average MME per day=
	unit Average MME per day*Projection output data[MME] 
	             * ( 1
	                  + RAMP ( Policy change average MME per day 
	                            / Policy rampup duration , 
	                       Policy activation time , 
	                       Policy activation time 
	                            + Policy rampup duration ) )
	~	MME/person/day
	~	The average strength (in MMEs) of opioid prescriptions, after accounting \
		for policy changes.
	|

MMT capacity estimated=
	unit MMT capacity estimated*Projection output data[MMTCap] 
	             * ( 1
	                  + RAMP ( Policy change MMT capacity 
	                            / Policy rampup duration , 
	                       Policy activation time , 
	                       Policy activation time 
	                            + Policy rampup duration ) )
	~	person
	~	Estimated capacity in Methadone treatment, ie, max number of people that \
		could theoretically be in Methadone treatment at a given time.
	|

Patients receiving opioid prescription annual=
	unit Patients receiving opioid prescription annual*Projection output data[PtRx] 
	             * ( 1
	                  + RAMP ( Policy change patients with opioid prescription 
	                            / Policy rampup duration , 
	                       Policy activation time , 
	                       Policy activation time 
	                            + Policy rampup duration ) )
	~	people/year
	~	Annual number of individuals who been prescribed an opioid as derived from \
		IQVIA and Symphony Health, after accounting for policy effects.
	|

Projection input data[Fent]:INTERPOLATE::=
	IMP DATA Fentanyl penetration curve ~~|
Projection input data[HPI]:INTERPOLATE::=
	Heroin price index DATA ~~|
Projection input data[MME]:INTERPOLATE::=
	((1-Switch for IQVIA MME and days per Rx) * Average MME per day DATA
	+
	Switch for IQVIA MME and days per Rx * Average MME per day IQVIA)/unit Average MME per day\
		 ~~|
Projection input data[BupCap]:INTERPOLATE::=
	Bup capacity estimated DATA/unit Bup capacity estimated ~~|
Projection input data[MMTCap]:INTERPOLATE::=
	MMT capacity estimated DATA/unit MMT capacity estimated ~~|
Projection input data[PtRx]:INTERPOLATE::=
	Patients receiving opioid prescription annual IQVIA/unit Patients receiving opioid prescription annual\
		 ~~|
Projection input data[NxKD]:INTERPOLATE::=
	Nx kits distributed HR IQVIA/unit Nx kits distributed net ~~|
Projection input data[ADF]:INTERPOLATE::=
	ADF fraction of prescribed Rx opioids base ~~|
Projection input data[RxPP]:INTERPOLATE::=
	Prescriptions per person DATA/unit Prescriptions per person ~~|
Projection input data[RxDur]:INTERPOLATE::=
	((1-Switch for IQVIA MME and days per Rx) * Average days per prescription DATA
	+
	Switch for IQVIA MME and days per Rx * Average days per prescription IQVIA)/unit Average days per prescription
	~	dmnl
	~	Subscripts cannot have more than one unit, which leads to unit errors when \
		working with multiple projection input streams. To address this, we \
		standardized the units of the projection inputs and end values to dmnl; \
		the unit conversion constants (e.g., unit Average MME per day = 1) restore \
		the units where the projected values are used. This prevents unit errors \
		and allows us to focus on identifying and resolving actual model errors.
	|

Prescriptions per person=
	unit Prescriptions per person*Projection output data[RxPP]
	             * ( 1
	                  + RAMP ( Policy change prescriptions per person
	                            / Policy rampup duration , 
	                       Policy activation time , 
	                       Policy activation time 
	                            + Policy rampup duration ) )
	~	Rx/person
	~		|

Projection curve end value[Fent]= INITIAL(
	 Projection curve end value fentanyl penetration) ~~|
Projection curve end value[HPI]= INITIAL(
	 Projection curve end value heroin price index) ~~|
Projection curve end value[MME]= INITIAL(
	 (1-Switch for IQVIA MME and days per Rx) * Projection curve end value average MME per day
	+
	Switch for IQVIA MME and days per Rx * Projection curve end value average MME per day IQVIA\
		) ~~|
Projection curve end value[BupCap]= INITIAL(
	Projection curve end value Bup capacity) ~~|
Projection curve end value[MMTCap]= INITIAL(
	 Projection curve end value MMT capacity) ~~|
Projection curve end value[PtRx]= INITIAL(
	 Projection curve end value patients with opioid prescription) ~~|
Projection curve end value[NxKD]= INITIAL(
	 Projection curve end value Nx kits distributed) ~~|
Projection curve end value[ADF]= INITIAL(
	 Projection curve end value ADF fraction of prescribed Rx opioids) ~~|
Projection curve end value[RxPP]= INITIAL(
	Projection curve end value prescriptions per person) ~~|
Projection curve end value[RxDur]= INITIAL(
	(1-Switch for IQVIA MME and days per Rx) * Projection curve end value days per prescription
	+
	Switch for IQVIA MME and days per Rx * Projection curve end value days per prescription IQVIA\
		)
	~	dmnl
	~	The value which we project an exogenous input will hit.
		Subscripts cannot have more than one unit, which leads to unit errors when \
		working with multiple projection input streams. To address this, we \
		standardized the units of the projection inputs and end values to dmnl; \
		the unit conversion constants (e.g., unit Average MME per day = 1) restore \
		the units where the projected values are used. This prevents unit errors \
		and allows us to focus on identifying and resolving actual model errors.
	|

Projection curve end value days per prescription IQVIA=
	26.79
	~	dmnl
	~	US value (26.79); not used in the Canadian version (only used when Switch for IQVIA \
		MME and days per Rx = 1; it is 0).
		Units standardized to dmnl because this value feeds the subscripted \
		Projection curve end value[Proj] (subscripts cannot have more than one \
		unit); the unit is restored by the unit conversion constants (e.g., unit \
		Average MME per day = 1).
	|

Average MME per opioid prescription IQVIA:INTERPOLATE:
	~	MME/Rx
	~		|

Projection curve end value average MME per day IQVIA=
	23.53
	~	dmnl
	~	US value (23.53); not used in the Canadian version (only used when Switch for IQVIA \
		MME and days per Rx = 1; it is 0).
		Units standardized to dmnl because this value feeds the subscripted \
		Projection curve end value[Proj] (subscripts cannot have more than one \
		unit); the unit is restored by the unit conversion constants (e.g., unit \
		Average MME per day = 1).
	|

Average days per prescription IQVIA:INTERPOLATE:
	~	person*day/Rx
	~		|

Switch for IQVIA MME and days per Rx=
	0
	~	dmnl [0,1,1]
	~	RxDur,MME
	|

Average MME per day IQVIA:INTERPOLATE::=
	Average MME per opioid prescription IQVIA / Average days per prescription IQVIA
	~	MME/person/day
	~		|

Projection curve end time[Fent]= INITIAL(
	 Projection curve end time fentanyl penetration) ~~|
Projection curve end time[HPI]= INITIAL(
	 Projection curve end time heroin price index) ~~|
Projection curve end time[MME]= INITIAL(
	 Projection curve end time average MME per day) ~~|
Projection curve end time[BupCap]= INITIAL(
	Projection curve end time Bup capacity) ~~|
Projection curve end time[MMTCap]= INITIAL(
	 Projection curve end time MMT capacity) ~~|
Projection curve end time[PtRx]= INITIAL(
	 Projection curve end time patients with opioid prescription) ~~|
Projection curve end time[NxKD]= INITIAL(
	 Projection curve end time Nx kits distributed) ~~|
Projection curve end time[ADF]= INITIAL(
	 Projection curve end time ADF fraction of prescribed Rx opioids) ~~|
Projection curve end time[RxPP]= INITIAL(
	Projection curve end time prescriptions per person) ~~|
Projection curve end time[RxDur]= INITIAL(
	Projection curve end time days per prescription)
	~	year
	~	The time that we expect the projection end curve to reach a specified \
		value.
	|

Projection curve end time Bup capacity=
	2036
	~	year [2010,2040,1]
	~	The time at which the user expects Bup capacity to approach its limit. \
		Value from ProjEndValsCA_base.cin.
	|

Projection curve end value Bup capacity=
	105724
	~	dmnl [100000,300000]
	~	The limit the user expects Bup capacity to approach. Value from \
		ProjEndValsCA_base.cin (base scenario), computed in ProjEndVals.Rmd; the \
		optimistic and pessimistic scenarios use ProjEndValsCA_optimistic.cin and \
		ProjEndValsCA_pessimistic.cin.
		Units standardized to dmnl because this value feeds the subscripted \
		Projection curve end value[Proj] (subscripts cannot have more than one \
		unit); the unit is restored by the unit conversion constants (e.g., unit \
		Average MME per day = 1).
	|

Bup capacity estimated DATA:INTERPOLATE:
	~	people
	~		|

Bup OAT capacity utilization=
	0.8
	~	dmnl
	~	Assumed effective treatment capacity fraction of 80% for both methadone \
		and buprenorphine. Informed by Canadian studies of OAT access and site \
		operations: 75% of 28 British Columbia OAT sites offered same-day or \
		drop-in treatment (Russell et al., 2025); 89% of 237 contacted Canadian \
		methadone clinics were accepting new patients and 83% offered an \
		appointment (Joudrey et al., 2021); 88% of 214 Canadian substance use \
		treatment programs admitted clients already receiving OAT, although only \
		30% initiated OAT onsite (Hodgins et al., 2022). These are access and \
		operational indicators, not direct measures of capacity utilization, and \
		no national estimates exist separately for methadone and buprenorphine; \
		80% was chosen as a plausible value within the reported 75-89% range. \
		Applied in Data imported into Vensim.xlsx (capacity = start-of-year \
		treatment receipt / 0.8); this model variable is not used in any equation. \
		[Sources: https://pmc.ncbi.nlm.nih.gov/articles/PMC12627284/ ; \
		https://pmc.ncbi.nlm.nih.gov/articles/PMC8303098/ ; \
		https://pmc.ncbi.nlm.nih.gov/articles/PMC9301153/]
	|

Average duration of medical opioid use DATA:INTERPOLATE::=
	Patients with current month opioid Rx IQVIA / Patients receiving opioid prescription annual IQVIA
	~	Years
	~	[DATA] Average person-years of use or exposure per year. Numerically \
		equivalent to the average duration of use (in years). [Source: IQVIA TPT]
	|

Projection curve end time days per prescription=
	2036
	~	year [2017,2040,1]
	~	The time at which the user expects average days per prescription to \
		approach its limit. Value from ProjEndValsCA_base.cin.
	|

Average days per prescription DATA:INTERPOLATE::=
	Average duration of medical opioid use DATA / Prescriptions per person DATA / OneDay
	~	person*day/Rx
	~	Average length of prescriptions, in days, based on average total duration \
		of opioid use per person compared to number of prescriptions per person.
	|

Average MME per day DATA:INTERPOLATE::=
	Avg MME per opioid Rx IQVIA / Average days per prescription DATA
	~	MME/person/day
	~		|

Projection curve end value days per prescription=
	4.77
	~	dmnl
	~	The limit the user expects the average days per prescription to approach. Value from \
		ProjEndValsCA_base.cin (base scenario), computed in ProjEndVals.Rmd; the \
		optimistic and pessimistic scenarios use ProjEndValsCA_optimistic.cin and \
		ProjEndValsCA_pessimistic.cin.
		Units standardized to dmnl because this value feeds the subscripted \
		Projection curve end value[Proj] (subscripts cannot have more than one \
		unit); the unit is restored by the unit conversion constants (e.g., unit \
		Average MME per day = 1).
	|

Patients with current month opioid Rx IQVIA:INTERPOLATE:
	~	people
	~	Estimated total number of unique (non-duplicated) patients with \
		current-month opioid analgesic prescriptions dispensed from Canadian \
		outpatient retail pharmacies. [Source: IQVIA TPT]
	|

Patients receiving opioid prescription annual IQVIA:INTERPOLATE:
	~	people/year
	~	Estimated total number of unique (non-duplicated) patients receiving \
		opioid analgesic prescriptions dispensed from Canadian outpatient retail \
		pharmacies each year (2009-2023). [Source: IQVIA NPA]
	|

Proj:
	Fent,NxKD,HPI,BupCap,MMTCap,PtRx,RxPP,RxDur,MME,ADF
	~	
	~		|

Heroin price index DATA:INTERPOLATE:
	~	dmnl
	~		|

Prescriptions per person DATA:INTERPOLATE::=
	Total prescription opioid Rx IQVIA 
	             / Patients receiving opioid prescription annual IQVIA
	~	Rx/person
	~	[DATA] Average number of prescriptions dispensed per patient. [Source: \
		IQVIA NPA & TPT]
	|

Fentanyl penetration curve=
	Projection output data[Fent] * (1 - Switch for no fentanyl)
	~	dmnl
	~	The proportion of opioid drugs positive for fentanyl or fentanyl analogues.
	|

ADF fraction of prescribed Rx opioids base
	~	dmnl
	~	The fraction of prescribed opioids that are FDA-approved abuse-deterrent \
		formulations (ADF). [Source: IQVIA NPA]
	|

Fentanyl introduction time=
	2013
	~	year [2000,2020,0.5]
	~	[DATA, ASM] The estimated year in which fentanyl penetrated the heroin \
		market enough to measurably affect overdose deaths. [US SOURCE: NFLIS] \
		[Canadian source: CCSA CCENDU fentanyl bulletin 2015; CVSD] The bulletin \
		(2009-2014 data) raised public health attention around 2014, but its \
		counts were already rising in 2012-2013, as were CVSD synthetic deaths \
		without heroin (166, 228, 264, 389 in 2011-2014); hence 2013. Used only to \
		split calibration data: synthetic deaths before this year are baseline, \
		later ones excess (fentanyl); prior nonfatal-to-fatal OD ratios apply only \
		before it.
	|

Fraction of HUD who use Rx=
	0.7729
	~	dmnl
	~	This exogenous data is used to estimate the total number of PWURx NP or \
		OUD as an output variable, which cannot be done directly in our model due \
		to not differentiating Rx use among NDHU Rx OUD with PY heroin and HUD. \
		[Source: CCHS, CCHS Mental health, CADS] Average of the survey years in \
		which the fraction is reported (not suppressed): CCHS 2003, CCHS Mental \
		Health 2012, CTADS/CADS 2015-2019 and CSUS 2023 (57/100). See Data \
		Calculations.xlsx, sheets Prevalence (rows 126-131) and Prevalence notes. \
		Its average also sets the share of HUD counted in Rx demand for Rx NP (Rx \
		availability).
	|

Fraction of NDHU who use Rx=
	0.6061
	~	dmnl
	~	This variable is used to estimate the total number of PWURx NP or OUD as \
		an output variable, which cannot be done directly in our model due to not \
		differentiating Rx use among NDHU Rx OUD with PY heroin and HUD. [Source: \
		CCHS, CCHS Mental health, CADS] Average of the survey years in which the \
		fraction is reported (not suppressed): CCHS 2003, CCHS Mental Health 2012, \
		CTADS/CADS 2015-2019; CSUS 2023 is suppressed. See Data Calculations.xlsx, \
		sheets Prevalence (rows 123-130) and Prevalence notes. Its average also \
		sets the share of NDHU counted in the social influence on initiating Rx NP \
		and in Rx demand for Rx NP (Rx availability).
	|

Heroin price index  = 
        Projection output data[HPI]
	~	dmnl
	~	Price of heroin relative to model initiation, plus projections into future.
	|

Nx kits distributed HR IQVIA
	~	kits
	~	The estimated number of kits distributed by harm reduction programs and \
		through mail and retail channels. [Canadian source: provincial and \
		territorial representatives and their public webpages, 2012-2024 \
		(supplement Table S2)] [US SOURCE: IQVIA, Wheeler 2015]
	|

Switch for no fentanyl=
	0
	~	dmnl [0,1,1]
	~	Switch for turning off presence of illegal fentanyl historically. If set \
		to 1, will yield counterfactual scenario with no illegal fentanyl.
	|

Avg MME per opioid Rx IQVIA := Total Rx MME prescribed IQVIA 
             / Total prescription opioid Rx IQVIA
	~	MME/Rx
	~	The average strength (in MMEs) of opioid prescriptions over time. [Source: \
		IQVIA NSP and NPA]
	|

IMP DATA Fentanyl penetration curve
	~	dmnl
	~	The proportion of opioid drugs tested in forensic settings that were \
		positive for fentanyl or fentanyl analogues. [Canadian source: Health \
		Canada Drug Analysis Service (DAS), 2012-2024] [US SOURCE: DEA National \
		Forensic Laboratory Information System (NFLIS)]
	|

MMT capacity estimated DATA:INTERPOLATE:
	~	people
	~		|

MMT OAT capacity utilization=
	0.8
	~	dmnl
	~	Assumed effective treatment capacity fraction of 80% for both methadone \
		and buprenorphine. Informed by Canadian studies of OAT access and site \
		operations: 75% of 28 British Columbia OAT sites offered same-day or \
		drop-in treatment (Russell et al., 2025); 89% of 237 contacted Canadian \
		methadone clinics were accepting new patients and 83% offered an \
		appointment (Joudrey et al., 2021); 88% of 214 Canadian substance use \
		treatment programs admitted clients already receiving OAT, although only \
		30% initiated OAT onsite (Hodgins et al., 2022). These are access and \
		operational indicators, not direct measures of capacity utilization, and \
		no national estimates exist separately for methadone and buprenorphine; \
		80% was chosen as a plausible value within the reported 75-89% range. \
		Applied in Data imported into Vensim.xlsx (capacity = start-of-year \
		treatment receipt / 0.8); this model variable is not used in any equation. \
		[Sources: https://pmc.ncbi.nlm.nih.gov/articles/PMC12627284/ ; \
		https://pmc.ncbi.nlm.nih.gov/articles/PMC8303098/ ; \
		https://pmc.ncbi.nlm.nih.gov/articles/PMC9301153/]
	|

Population
	~	people
	~	Total Canadian population aged 12 and older. Population is used in the \
		model to standardize the effect of social influence relative to the size \
		of the current 'at risk' population. We limit to persons 12 and older \
		because we assume children under 12 are not at great risk of initiating Rx \
		NP use. [Source: Statistics Canada]
	|

Total prescription opioid Rx IQVIA
	~	Rx/year
	~	Estimated annual number of opioid analgesic prescriptions dispensed from \
		Canadian outpatient pharmacies (2009-2022). [Source: IQVIA TPT]
	|

Total Rx MME prescribed IQVIA
	~	MME/year
	~	Total prescription opioids prescribed in units of morphine milligram \
		equivalents (MMEs), a standardized way of comparing opioid medications \
		according to their relative potency. [Source: IQVIA]
	|

Projection start time[Proj]= INITIAL(
	MIN(Projection last data time[Proj],MaxDataTime))
	~	year
	~	Note: MaxDataTime functions as override for projections data. Only \
		exogenous data prior to MaxDataTime will be used in generating \
		projections. If MaxDataTime is later than last available data point, then \
		exogenous data up to the last available data point will be used and \
		projection curves will be fitted to the last available data point.
	|

Projection last data time[Proj]= INITIAL(
	GET DATA LAST TIME ( Projection input data[Proj] ))
	~	year
	~		|

Projection curve end value heroin price index=
	1
	~	dmnl
	~	The limit the user expects the heroin price (relative to model start time) to \
		approach. Value from ProjEndValsCA_base.cin (base scenario), computed in \
		ProjEndVals.Rmd; the optimistic and pessimistic scenarios use \
		ProjEndValsCA_optimistic.cin and ProjEndValsCA_pessimistic.cin.
		Units standardized to dmnl because this value feeds the subscripted \
		Projection curve end value[Proj] (subscripts cannot have more than one \
		unit); the unit is restored by the unit conversion constants (e.g., unit \
		Average MME per day = 1).
	|

Projection curve end value prescriptions per person=
	8.12
	~	dmnl
	~	The limit the user expects the number of prescriptions per person receiving an \
		opioid prescription to approach. Value from ProjEndValsCA_base.cin (base \
		scenario), computed in ProjEndVals.Rmd; the optimistic and pessimistic \
		scenarios use ProjEndValsCA_optimistic.cin and \
		ProjEndValsCA_pessimistic.cin.
		Units standardized to dmnl because this value feeds the subscripted \
		Projection curve end value[Proj] (subscripts cannot have more than one \
		unit); the unit is restored by the unit conversion constants (e.g., unit \
		Average MME per day = 1).
	|

Projection curve end time prescriptions per person=
	2036
	~	year [2017,2040,1]
	~	The time at which the user expects prescriptions per person to approach \
		its limit. Value from ProjEndValsCA_base.cin.
	|

Projection output data[Proj]  = 
        IF THEN ELSE ( Time 
                  <= Projection start time[Proj] , 
             Projection input data[Proj] , 
             Switch for constant projections[Proj] 
                  * Projection input data[Proj] 
                  + ( 1
                       - Switch for constant projections[Proj] ) 
                       * Logistic growth curve[Proj] )
	~	dmnl
	~	Trend projections to extend the input (exogenous) time series data used to \
		drive the base model.
	|

Logistic growth curve[Proj]  = 
        IF THEN ELSE ( Projection curve end value[Proj] 
                  > Projection last data value[Proj] , 
             MIN ( Projection curve end value[Proj] , 
                  ( ( Projection curve end value[Proj] 
                       - Projection last data value[Proj] ) 
                       / 0.5) 
                       / ( 1
                            + EXP ( ( -5
                                      / ( Projection curve end time[Proj] 
                                           - Projection start time[Proj] ) ) 
                                      * ( Time 
                                           - Projection start time[Proj] ) ) ) 
                       + ( Projection curve end value[Proj] 
                            - ( Projection curve end value[Proj] 
                                 - Projection last data value[Proj] ) 
                                 / 0.5) ) , 
             Max ( Projection curve end value[Proj] , 
                  ( ( Projection curve end value[Proj] 
                       - Projection last data value[Proj] ) 
                       / 0.5) 
                       / ( 1
                            + EXP ( ( -5
                                      / ( Projection curve end time[Proj] 
                                           - Projection start time[Proj] ) ) 
                                      * ( Time 
                                           - Projection start time[Proj] ) ) ) 
                       + ( Projection curve end value[Proj] 
                            - ( Projection curve end value[Proj] 
                                 - Projection last data value[Proj] ) 
                                 / 0.5) ) )
	~	dmnl
	~		|

Projection curve end time ADF fraction of prescribed Rx opioids=
	2036
	~	year [2017,2040,1]
	~	The time at which the user expects the ADF fraction of prescribed Rx \
		opioids to approach its limit. Value from ProjEndValsCA_base.cin.
	|

Projection curve end time average MME per day=
	2036
	~	year [2017,2040,1]
	~	The time at which the user expects avg MME per day to approach its limit. \
		Value from ProjEndValsCA_base.cin.
	|

Projection curve end time fentanyl penetration=
